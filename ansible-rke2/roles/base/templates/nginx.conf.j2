# managed by ansible (hpc base): serves the offline dnf repo, the site's own RPMs, the chart
# repository, Rancher UI extension files and the CA, TLS only.
user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log;
pid /run/nginx.pid;
events { worker_connections 1024; }
http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log /var/log/nginx/access.log;
  sendfile on;
  server_tokens off;
  server {
    listen {{ hpc_admin_ip }}:{{ hpc_repo_port }} ssl;
    server_name {{ hpc_admin_host }}.{{ hpc_domain }};
    ssl_certificate /etc/pki/hpc/admin.crt;
    ssl_certificate_key /etc/pki/hpc/admin.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    root {{ hpc_data_root }}/www;
{% if hpc_offline_repo | bool %}
    location /repo/ { alias {{ hpc_data_root }}/bundle/rpms/; autoindex on; }
{% endif %}
{% if _hpc_local_rpms | length > 0 %}
    location /local/ { alias {{ hpc_data_root }}/local-rpms/; autoindex on; }
{% endif %}
{% if hpc_enable_charts_repo | bool %}
    location /charts/ { alias {{ hpc_data_root }}/charts/; autoindex on; }
{% endif %}
{% if _hpc_ui_plugins | bool %}
    location /ui-plugins/ { alias {{ hpc_data_root }}/ui-plugins/; autoindex on; }
{% endif %}
  }
}
