{% if hpc_coredns_forward_domain | bool %}
# Cluster DNS answers {{ hpc_domain }} from the admin node (dnsmasq), so pods
# resolve the service names whatever the nodes' own resolvers are. The first
# server block is the chart's default, unchanged.
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: rke2-coredns
  namespace: kube-system
spec:
  valuesContent: |-
    servers:
    - zones:
      - zone: .
        use_tcp: true
      port: 53
      plugins:
      - name: errors
      - name: health
        configBlock: |-
          lameduck 10s
      - name: ready
      - name: kubernetes
        parameters: in-addr.arpa ip6.arpa
        configBlock: |-
          pods insecure
          fallthrough in-addr.arpa ip6.arpa
          ttl 30
      - name: prometheus
        parameters: 0.0.0.0:9153
      - name: forward
        parameters: . /etc/resolv.conf
      - name: cache
        parameters: 30
      - name: loop
      - name: reload
      - name: loadbalance
    - zones:
      - zone: {{ hpc_domain }}.
        use_tcp: true
      port: 53
      plugins:
      - name: errors
      - name: forward
        parameters: . {{ hpc_admin_ip }}
      - name: cache
        parameters: 30
{% else %}
# hpc_coredns_forward_domain is false: CoreDNS uses the nodes' resolvers.
apiVersion: v1
kind: List
items: []
{% endif %}
