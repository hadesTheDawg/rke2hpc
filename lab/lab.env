# QEMU lab sizing. The lab only produces VMs + an ssh config; nothing in
# modules/ knows it exists.
LAB_BASE_IMAGE_URL=https://dl.rockylinux.org/pub/rocky/9/images/aarch64/Rocky-9-GenericCloud-Base.latest.aarch64.qcow2
LAB_SSH_PORT=2222          # host port forwarded to the login node's sshd
LAB_ADMIN_USER=hpcadmin    # sudo-capable deploy user created by cloud-init

# Cluster nodes (admin + compute) get two networks, like the production layout:
#   management: bond0 (one-port active-backup bond) on CLUSTER_CIDR   ssh, API, registry, NFS
#   high-speed: hsn0 on LAB_HSN_CIDR                                    pod-to-pod traffic
# The login node (jump host / RPM fetch host) is on the management network only.
LAB_MGMT_IFACE=bond0
LAB_HSN_IFACE=hsn0
LAB_HSN_CIDR=10.20.0.0/24  # host part of each node's mgmt address is reused here

# name  cpus  mem_mib  disk_gb
LAB_SIZES="
l1  2   2048   20
a1  6   16384  120
c1  4   8192   40
c2  4   8192   40
c3  4   8192   40
"

# The admin node gets a second disk that `lab.sh reprovision a1` keeps: it
# stands in for the site's CephFS mount (storage that outlives a re-provisioned
# node). Mounted by cloud-init, as HPCM mounts Ceph at boot.
LAB_PERSIST_GB=20
LAB_PERSIST_MOUNT=/rhev/data-center/mnt/cephfs
