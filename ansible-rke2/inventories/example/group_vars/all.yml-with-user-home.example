# Site settings, WITH USER HOMES (see the pod identity section). Defaults (with comments) are in
# roles/hpc_common/defaults/main.yml and roles/bundle/defaults/main.yml;
# docs/variables.md lists them. Put secrets (Ceph key) in a vault file:
#   ansible-vault create inventories/<site>/group_vars/vault.yml

hpc_arch: amd64
hpc_cluster_name: hpc
hpc_domain: hpc.example.org        # names below it resolve to the admin node

# ---- networks ----------------------------------------------------------------
hpc_mgmt_iface: bond0              # node IP, API, registry, NFS, ssh
hpc_pod_iface: hsn0                # pod-to-pod overlay
hpc_pod_mtu: 0                     # 0 = 1450; with a 9000-byte HSN set 8950
hpc_cluster_cidr: 10.42.0.0/16     # must not overlap bond0 / hsn networks
hpc_service_cidr: 10.43.0.0/16
# hpc_node_cidrs: [172.16.0.0/22, 10.150.0.0/16, 10.200.0.0/16]  # bond0, hsn, storage: blocked for pods

# ---- packages / offline ---------------------------------------------------------
hpc_offline: true                  # nodes have no internet
hpc_offline_repo: true             # RPMs from the bundle (needs the rpm_fetch host); false = site repos

# ---- DNS / time ------------------------------------------------------------------
hpc_manage_dns: true               # dnsmasq on the admin node for {{ hpc_domain }}
hpc_coredns_forward_domain: true
hpc_ntp_servers: []                # e.g. [ntp1.example.org]

# ---- storage -----------------------------------------------------------------------
hpc_storage_backend: nfs           # nfs | cephfs | none  (default StorageClass)
hpc_enable_ceph_csi: false         # true to install the CephFS driver
# hpc_ceph_cluster_id: "b5a1...fsid"
# hpc_ceph_monitors: ["10.200.0.1:6789", "10.200.0.2:6789", "10.200.0.3:6789"]
# hpc_ceph_fs_name: cephfs
# hpc_ceph_user_id: k8s
# hpc_ceph_user_key: "{{ vault_ceph_user_key }}"

# ---- pod identity and home directories ------------------------------------------------
# THE VERSION WITH USER HOMES. Copy over all.yml (or merge this section) when
# pods should run as their submitter's uid/gid and get their home mounted.
# Project pods run as the submitter's uid, the common primary gid and the
# project gid (stable ids from secrets/state/idmap.json), with HOME set, and
# the home <hpc_home_root>/<user> mounted from NFS.
hpc_pod_identity: uid
hpc_home_volume: nfs
hpc_home_root: /c/home             # path inside pods (same as on the login nodes)
# Homes exported by the admin node (default, under hpc_persist_root when set),
# created by hpc-sync from /etc/skel. Or point at the site's NFS server:
# hpc_home_nfs_server: 172.16.0.20
# hpc_home_nfs_path: /export/home
# hpc_home_create_root: ""          # homes are created by the site, not by hpc-sync
# hpc_nfs_home_extra_clients: [10.10.0.5]   # login nodes that mount the same homes

# ---- identity --------------------------------------------------------------------
hpc_platform_admin_users: [opsadmin]
hpc_keycloak_allow_password_grant: false   # true only while running verify.yml

# Nodes the cluster manager can re-provision (wipe): keep the admin node's
# state on storage that outlives it, e.g. the CephFS mount the nodes get at
# boot. Exports, Keycloak DB and hourly etcd/accounting backups go there, and
# a wiped admin node is restored by re-running site.yml (docs/reprovisioning.md).
# hpc_persist_root: /rhev/data-center/mnt/cephfs/rke2
