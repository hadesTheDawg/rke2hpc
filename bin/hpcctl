#!/usr/bin/env bash
# hpcctl - drive the deployment. Each module under modules/ is independent,
# idempotent and only talks to hosts through the inventory + ssh config.
. "$(cd "$(dirname "$0")/.." && pwd)/lib/common.sh"

modules() { (cd "$HPC_ROOT/modules" && ls -d [0-9]*/ 2>/dev/null | tr -d /); }
resolve() { # accept "40-rke2", "rke2" or "40"
  local want="$1" m
  for m in $(modules); do
    if [ "$m" = "$want" ] || [ "${m#*-}" = "$want" ] || [ "${m%%-*}" = "$want" ]; then echo "$m"; return; fi
  done
  die "unknown module '$want' (see: hpcctl list)"
}
describe() { sed -n 's/^# DESC: //p' "$HPC_ROOT/modules/$1/run.sh" | head -1; }
run_module() {
  local m; m=$(resolve "$1"); shift
  step "module $m: $(describe "$m")"
  HPC_MODULE_DIR="$HPC_ROOT/modules/$m" bash "$HPC_ROOT/modules/$m/run.sh" "$@"
}

usage() {
  cat >&2 <<USAGE
usage: hpcctl <command>
  list                     show modules in deployment order
  deploy [--from <module>] run every module in order (optionally starting at one)
  run <module> [args]      run a single module (name, number or NN-name)
  verify                   run the acceptance checks
  ssh <host> [cmd]         ssh to an inventory host
  kubectl <args>           kubectl as cluster-admin (runs on the admin node)
  acct <args>              job accounting / time budgets (hpc-acct on the admin node; try: acct --help)
  secret <name>            print a generated credential (see secrets/)
USAGE
  exit 2
}

cmd="${1:-}"; [ $# -gt 0 ] && shift
case "$cmd" in
  list)   for m in $(modules); do printf '%-14s %s\n' "$m" "$(describe "$m")"; done ;;
  run)    [ $# -ge 1 ] || usage; run_module "$@" ;;
  deploy)
    from=""; [ "${1:-}" = "--from" ] && from=$(resolve "${2:?--from needs a module}")
    for m in $(modules); do
      [ "$m" = 90-verify ] && continue
      if [ -n "$from" ] && [ "$m" \< "$from" ]; then continue; fi
      run_module "$m"
    done
    ok "deployment complete; run 'hpcctl verify'" ;;
  verify) run_module verify "$@" ;;
  ssh)    [ $# -ge 1 ] || usage; exec ssh -F "$HPC_SSH_CONFIG" "$@" ;;
  kubectl) admin_kubectl "$@" ;;
  acct)   args=""; for x in "$@"; do args="$args $(printf '%q' "$x")"; done
          hssh "$(admin_host)" "sudo -n /usr/local/sbin/hpc-acct $args" ;;
  secret) [ $# -eq 1 ] || usage; [ -s "$SECRETS_DIR/$1" ] || die "no such secret: $1"; cat "$SECRETS_DIR/$1"; echo ;;
  *) usage ;;
esac
