# Site configuration. Plain KEY=VALUE shell, sourced on the deployer AND shipped
# to every node script, so keep it free of commands and deployer-only paths.
# Override anything per-site in config/site.local.env (gitignored).

# ---- identity of the site ---------------------------------------------------
CLUSTER_NAME=hpc
CLUSTER_DOMAIN=hpc.internal
CLUSTER_CIDR=10.10.0.0/24          # node network (used for NFS exports, chrony, dnsmasq)
POD_CIDR=10.42.0.0/16              # must not overlap the node network
SERVICE_CIDR=10.43.0.0/16

# ---- target platform --------------------------------------------------------
# Production is x86_64; the QEMU lab on Apple silicon is aarch64.
ARCH=arm64                          # arm64 | amd64
EL_MAJOR=9

# ---- versions (everything is pinned; bump here and re-run `hpcctl bundle`) ---
RKE2_VERSION=v1.36.6+rke2r1
RKE2_CNI=canal                      # canal enforces NetworkPolicy
RANCHER_VERSION=2.15.3
KEYCLOAK_VERSION=26.8.2
POSTGRES_VERSION=17.6
REGISTRY_VERSION=3.1.2              # CNCF distribution
HELM_VERSION=v4.3.2
KUBELOGIN_VERSION=v1.36.4
NFS_PROVISIONER_CHART_VERSION=4.0.18
NFS_PROVISIONER_IMAGE_TAG=v4.0.2

# ---- service names (all resolve to the admin node) --------------------------
REGISTRY_SYSTEM_HOST=registry.hpc.internal   # RKE2/platform images, authenticated
REGISTRY_SYSTEM_PORT=5000
REGISTRY_SYSTEM_RW_PORT=5010                 # push endpoint, loopback on admin node only
REGISTRY_USER_HOST=hub.hpc.internal          # HPC user images, read-only
REGISTRY_USER_PORT=5001
REGISTRY_USER_RW_PORT=5011                   # push endpoint, loopback on admin node only
REPO_PORT=8443                               # offline dnf repo + artifacts (nginx, TLS)
KUBE_API_HOST=kube.hpc.internal
RANCHER_HOST=rancher.hpc.internal
KEYCLOAK_HOST=keycloak.hpc.internal
APPS_DOMAIN=apps.hpc.internal                # tenant ingress: <app>.<namespace>.apps.hpc.internal

# ---- storage ------------------------------------------------------------------
DATA_ROOT=/srv/hpc                  # admin node: bundle, registries, repo
NFS_HOME_EXPORT=/c/home             # exported from admin node, mounted on login node(s)
NFS_K8S_EXPORT=/c/k8s               # backs the default StorageClass (PVCs)
HOME_ROOT=/c/home                   # home directories are $HOME_ROOT/$USER

# ---- identity -----------------------------------------------------------------
KEYCLOAK_REALM=hpc
UID_START=5001
GID_START=6001
PLATFORM_ADMIN_GROUP=hpc-admins     # Keycloak group -> cluster-admin + Rancher admin
PLATFORM_ADMIN_USERS="opsadmin"     # Keycloak-only accounts (no unix account)
OIDC_GROUP_PREFIX="oidc:"           # prefix on group names as seen by Kubernetes RBAC
# kubectl login flow on the login node: device-code (browser on your workstation,
# through the SOCKS proxy) or password (prompt in the terminal; lab convenience).
KUBELOGIN_GRANT=device-code
KEYCLOAK_ALLOW_PASSWORD_GRANT=true  # lab: lets tests fetch tokens non-interactively
INITIAL_PASSWORDS_TEMPORARY=false   # true => users must change password at first login
LOGIN_SSH_PASSWORD_AUTH=true        # users reach the login node with their initial password

# Optional upstream OIDC provider brokered through Keycloak (leave empty to skip).
# The upstream `preferred_username` becomes the Keycloak / unix username.
UPSTREAM_OIDC_ISSUER=
UPSTREAM_OIDC_CLIENT_ID=
UPSTREAM_OIDC_ALIAS=upstream
# Lab: stand up a second realm in the same Keycloak that plays the upstream IdP.
UPSTREAM_OIDC_SPOOF=false

# ---- tenancy defaults ---------------------------------------------------------
TENANT_POD_SECURITY=baseline        # pod-security.kubernetes.io/enforce level
TENANT_DEFAULT_CPU_REQUEST=500m     # LimitRange defaults (pods must fit the quota)
TENANT_DEFAULT_CPU_LIMIT=1
TENANT_DEFAULT_MEM_REQUEST=512Mi
TENANT_DEFAULT_MEM_LIMIT=1Gi

# ---- deployer -----------------------------------------------------------------
# ssh config that can reach every inventory host by name with a sudo-capable user.
# The lab writes .lab/ssh_config; for a real site point this at your own.
HPC_SSH_CONFIG=.lab/ssh_config
# Host used to download RPMs: any EL$EL_MAJOR box of the target ARCH with internet.
RPM_FETCH_HOST=l1

# ---- node baseline ------------------------------------------------------------
OFFLINE_ROLES="admin compute"       # roles whose distro repos are disabled (no internet)
MANAGE_DNS=true                     # run dnsmasq on the admin node for $CLUSTER_DOMAIN
MANAGE_TIME=true                    # admin node serves time (chrony); other nodes follow it
NFS_HOME_CLIENT_ROLES="login"       # roles that mount $HOME_ROOT on the host
NFS_HOME_EXPORT_ROLES="login compute" # roles allowed to mount it (compute: kubelet mounts homes into pods)

# ---- platform -------------------------------------------------------------------
# Everything that is not a project namespace runs on the admin node
# (PodNodeSelector annotation). These namespaces are created up front so the pin
# exists before their first pod; namespaces that Rancher creates later are pinned
# after the fact. kube-system is left alone: DNS and the CNI serve every node.
PLATFORM_NAMESPACES="hpc-storage keycloak cattle-system cattle-fleet-system cattle-fleet-local-system"
UNPINNED_NAMESPACES="kube-system kube-public kube-node-lease default"
STORAGE_CLASS=nfs

# ---- usage accounting (module 89-accounting, docs/accounting.md) ----------------------
TENANT_DEFAULT_CPU_HOURS=1000       # yearly allocation when a flat-file line gives none (informational)
ACCT_PERIOD_START=10-01             # the accounting year starts on this date (MM-DD, UTC); history is kept
ACCT_POLL_SECONDS=5                 # how often the recorder reads the cluster
