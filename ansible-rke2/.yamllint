# yamllint settings for check.sh. Templates (*.j2) are Jinja, not YAML.
extends: default
ignore: |
  .bundle/
  .logs/
  inventories/*/secrets/
  *.j2
  docs/examples/
rules:
  line-length: {max: 160, level: warning}
  truthy: {allowed-values: ["true", "false"], check-keys: false}
  comments: {min-spaces-from-content: 1}
  comments-indentation: disable
  document-start: disable
  braces: {max-spaces-inside: 1}
  brackets: {max-spaces-inside: 1}
  indentation: {spaces: 2, indent-sequences: consistent}
  octal-values: {forbid-implicit-octal: true}
