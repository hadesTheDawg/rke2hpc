#!/bin/bash
# hpc-kubeconfig: write ~/.kube/config for the calling user - one context per
# project group they belong to. Authentication is OIDC (your cluster login);
# no credentials are stored in the file.   Usage: hpc-kubeconfig [--force]
set -euo pipefail
. /etc/hpc/kube.env
cfg="$HOME/.kube/config"
if [ -e "$cfg" ] && [ "${1:-}" != "--force" ]; then
  echo "$cfg exists; use --force to regenerate it" >&2; exit 1
fi
projects=()
for g in $(id -Gn); do
  grep -qxF "$g" /etc/hpc/project-groups 2>/dev/null && projects+=("$g")
done
[ ${#projects[@]} -gt 0 ] || { echo "you are not a member of any project group" >&2; exit 1; }
mkdir -p "$HOME/.kube"; umask 077
{
  cat <<YAML
apiVersion: v1
kind: Config
clusters:
- name: $HPC_CLUSTER_NAME
  cluster:
    server: $HPC_KUBE_SERVER
    certificate-authority: /etc/hpc/kube-ca.crt
users:
- name: oidc
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1
      command: /usr/local/bin/kubectl-oidc_login
      interactiveMode: IfAvailable
      args:
      - get-token
      - --oidc-issuer-url=$HPC_OIDC_ISSUER
      - --oidc-client-id=kubernetes
      - --grant-type=$HPC_KUBELOGIN_GRANT
YAML
  [ "$HPC_KUBELOGIN_GRANT" = password ] && echo "      - --username=$(id -un)"
  echo "contexts:"
  for g in "${projects[@]}"; do
    printf -- '- name: %s\n  context: {cluster: %s, user: oidc, namespace: %s}\n' "$g" "$HPC_CLUSTER_NAME" "${g,,}"
  done
  echo "current-context: ${projects[0]}"
} >"$cfg"
echo "wrote $cfg (contexts: ${projects[*]}); switch with: kubectl config use-context <PROJECT>" >&2
